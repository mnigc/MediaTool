# Copy to docker/.env and edit. `docker compose` reads it automatically.

# Access token. Required — the server refuses to start without one, because
# it exposes directory browsing and job execution to the LAN.
# Generate one:  openssl rand -hex 24
MEDIATOOL_TOKEN=

# Host port to publish. The container always listens on 8787.
PORT=8787

# Your media, mounted read-only at /media/library.
# Synology example: /volume1/video    Unraid example: /mnt/user/media
MEDIA_LIBRARY=

# Where finished files go, mounted writable at /media/output.
# Put this somewhere other than inside MEDIA_LIBRARY.
OUTPUT_DIR=

# The address *your browser* types to reach the UI, e.g.
#   http://192.168.1.10:8787   or   https://media.example.com
# Only YouTube / Google Drive / OneDrive authorization needs it: those logins
# bounce through <this>/oauth/callback, and the container cannot guess which
# host name you used. Leave empty and everything else still works.
# Google and Microsoft both prefer HTTPS for a non-loopback callback; if they
# reject a plain http:// one, put a reverse proxy with a certificate in front.
PUBLIC_URL=

TZ=Asia/Shanghai

# Set to `debug` while working out why an encoder is not showing up.
# RUST_LOG=mediatool_server=debug,info
