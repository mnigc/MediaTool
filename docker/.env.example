# Copy this file to .env (same folder) and fill in the values.
# `docker compose` reads .env automatically — no other wiring needed.

# [REQUIRED] Access token for the UI and API: any random string,
# e.g. generate one with `openssl rand -hex 16`. The server refuses
# to start without it.
MEDIATOOL_TOKEN=

# [REQUIRED] Host directory with your media files. Mounted read-only at
# /media/library so a job can never destroy its own source.
# Example (Synology): /volume1/media
MEDIA_LIBRARY=

# [REQUIRED] Host directory for finished files, writable. Keep it OUTSIDE
# MEDIA_LIBRARY. Example: /volume1/media-output
OUTPUT_DIR=

# [OPTIONAL] Host port to publish; container always listens on 8787.
PORT=8787

# Optional features live as commented lines in docker-compose.yml
# (PUBLIC_URL for browser OAuth, TZ, Intel GPU passthrough) — uncomment
# them there when needed.
