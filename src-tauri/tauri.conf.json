{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaTool",
  "version": "0.1.1",
  "identifier": "com.mediatool.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MediaTool",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/ffmpeg.exe": "binaries/",
      "binaries/ffprobe.exe": "binaries/"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/mnigc/MediaTool/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCM0Y5QTJBNjE4MTk4MzcKUldRM21JRmhLcG8vdTczdXdZUHhDNE1WYTBDT2liNEs1ekQwQXBMeCswWlZtbnZJcXlXUnJnVSsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
